// hunt — local-first job-hunt platform.
// Single-user SQLite on disk. No auth, no tenancy, no telemetry.
//
// SQLite has no native enum type, so status/kind columns are Strings whose
// legal values are documented on the field and enforced in `src/lib/db/enums.ts`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A résumé "line" — the container. Versions hold the actual content.
model Resume {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  ResumeVersion[]
}

/// One immutable-ish snapshot of résumé content. Tailoring creates children.
model ResumeVersion {
  id              String   @id @default(cuid())
  resumeId        String
  label           String
  /// ResumeContent JSON (superset of JSON Resume) — see src/lib/resume/schema.ts
  content         String
  /// Escape hatch: hand-edited .tex that detaches this version from the editor.
  rawLatexOverride String?
  parentVersionId String?
  templateId      String?
  createdAt       DateTime @default(now())

  resume       Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  parent       ResumeVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children     ResumeVersion[] @relation("VersionLineage")
  template     Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  applications Application[]
  checks       CheckResult[]

  @@index([resumeId])
  @@index([parentVersionId])
}

/// A LaTeX résumé template (Jake's, moderncv, …).
model Template {
  id       String          @id @default(cuid())
  name     String          @unique
  /// Rendering engine. Only "latex" in v1.
  engine   String          @default("latex")
  /// The .tex source with placeholders.
  source   String
  versions ResumeVersion[]
}

/// A job posting, however it arrived.
model Job {
  id           String   @id @default(cuid())
  url          String?  @unique
  title        String
  company      String
  location     String?
  jdText       String
  companyBlurb String?
  /// paste | api | linkedin | manual
  source       String   @default("paste")
  scrapedAt    DateTime?
  createdAt    DateTime @default(now())

  applications Application[]
  checks       CheckResult[]

  @@index([company])
}

/// The pipeline row. `resumeVersionId` pins the exact version sent — provenance
/// for the future "what actually converts" analytics.
model Application {
  id              String   @id @default(cuid())
  jobId           String
  resumeVersionId String?
  /// sourced | tailored | applied | outreach | replied | interview | offer | rejected
  status          String   @default("sourced")
  /// strong | possible | reach — qualitative only, never a fake percentage.
  fitTier         String?
  fitReasons      String?
  notes           String?
  appliedAt       DateTime?
  repliedAt       DateTime?
  interviewAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  outreach      Outreach[]

  @@index([status])
  @@index([jobId])
}

/// A human at a target company.
model Contact {
  id            String   @id @default(cuid())
  applicationId String?
  name          String
  title         String?
  company       String?
  email         String?
  linkedinUrl   String?
  /// apollo | linkedin | manual | brightdata
  source        String   @default("manual")
  createdAt     DateTime @default(now())

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  outreach    Outreach[]

  @@index([applicationId])
}

/// One message in an outreach sequence.
model Outreach {
  id            String    @id @default(cuid())
  applicationId String
  contactId     String?
  /// 1 = initial, 2..n = follow-ups.
  sequenceStep  Int       @default(1)
  /// Days after the previous step that this one is due.
  dayOffset     Int       @default(0)
  subject       String
  body          String
  /// draft | scheduled | sent | replied | bounced | halted
  /// `halted` = a reply landed on an earlier step, so this one never sends.
  /// The row survives so the sequence's history stays readable.
  status        String    @default("draft")
  sentAt        DateTime?
  threadRef     String?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
}

/// An honest check result. There is deliberately no aggregate "ATS score".
model CheckResult {
  id              String   @id @default(cuid())
  resumeVersionId String
  jobId           String?
  /// parse_fidelity | keyword_coverage | format_lint | ai_tell | match_rating
  kind            String
  /// pass | warn | fail
  verdict         String
  /// Human-readable concrete count, e.g. "18 / 22 JD terms".
  summary         String
  /// Structured specifics as JSON.
  details         String
  createdAt       DateTime @default(now())

  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([resumeVersionId])
}

/// One execution of a saved job search.
model SourcingRun {
  id          String   @id @default(cuid())
  /// Query params as JSON.
  query       String
  adapter     String
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())
}

/// Key-value config. Values marked `encrypted` are AES-256-GCM sealed with the
/// local secret file — see src/lib/settings/crypto.ts. Keys never leave disk.
model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
